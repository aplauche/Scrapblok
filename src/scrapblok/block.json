{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ap/scrapblok",
	"version": "0.1.0",
	"title": "Scrapblok",
	"category": "layout",
	"icon": "grid-view",
	"description": "Wrapper for creating dynamic collage content in the block editor",
	"example": {},
	"attributes": {
		"hideOverflow": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": false,
			"background": true
		},
		"align": ["wide", "full"],
		"anchor": true,
		"spacing": {
			"margin": true,  
			"padding": true, 
			"blockGap": false
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
